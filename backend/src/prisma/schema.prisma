// ============================================
// One Page — Prisma Schema
// 기준 문서: docs/02_erd.md (v1.1)
// ============================================

// generator = "이 스키마를 읽어서 무엇을 만들어낼래?"
// 붕어빵 틀에 반죽 부으면 붕어빵 나오듯,
// 이 스키마를 부으면 TypeScript용 DB 조작 코드(Prisma Client)가 나온다.
generator client {
  provider = "prisma-client-js"
}

// datasource = "창고 주소가 어디야?"
// env("DATABASE_URL")은 .env 파일에서 주소를 꺼내오는 것.
// 주소를 코드에 직접 쓰지 않는 이유: GitHub에 비밀번호가 올라가면 안되니까.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ====================================================
// ENUM 정의
// enum = "객관식 보기"
// 아무 글자나 못 들어오고, 여기 적힌 것만 허용된다.
// 오타로 'HAPY' 같은 게 저장되는 사고를 DB 차원에서 막아준다.
// ====================================================

enum Emotion {
  HAPPY // 😊
  CALM // 😌
  SAD // 😢
  ANGRY // 😡
  ANXIOUS // 😰
  EXCITED // 🤩
  TIRED // 😩
}

enum ReportType {
  MONTH
  YEAR
}

// ============================================
// Users — 회원
// ============================================

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(100)
  password     String    @db.VarChar(255) // 평문 아님. bcrypt로 해싱된 결과가 들어간다 
  nickname     String    @unique @db.VarChar(30)
  profileImage String?   @map("profile_image") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // Soft Delete 표식

  // 관계 필드 — 실제 컬럼이 아니라 "이 사람이 쓴 일기 목록 좀 줘" 라고 요청하는 통로.
  // 도서관 회원중에 븥은 '대출 목록 조회' 버튼 같은 것.
  diaries   Diary[]
  aiReports AiReport[]

  @@map("users") // 모델명은 User(단수), 실제 테이블명은 users(복수)
}

// ============================================
// Diaries — 일기 (서비스의 심장)
// ============================================

model Diary {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String?   @db.VarChar(100)
  content     String    @db.Text // VarChar보다 긴 글용. 일기는 내용이 길어질 수 있으니까
  emotion     Emotion
  weather     String?   @db.VarChar(30)
  temperature Decimal?  @db.Decimal(4, 1) // 4자리 중 소숫점 1자리 → -99.9 ~ 999.9
  location    String?   @db.VarChar(100)
  aiSummary   String?   @map("ai_summary") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // relation = "이 일기의 주인이 누구인지 연결하는 끈"
  // fields: 내 쪽 컬럼 / references: 상대 쪽 컬럼
  // onDelete: Cascade = 주인이 사라지면 이 일기도 같이 사라짐
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      Photo[]
  musics      Music[]
  diaryTags   DiaryTag[]
  timeCapsule TimeCapsule? // ?가 붙으면 "있을 수도, 없을 수도" (1:0..1)

  @@index([userId])
  @@index([createdAt])
  @@index([emotion]) // index = 책 뒤 '찾아보기' 페이지. 없으면 전체를 처음부터 훑어야 함
  @@map("diaries")
}

// ============================================
// Photos — 일기에 첨부된 사진
// ============================================

model Photo {
  id        Int      @id @default(autoincrement())
  diaryId   Int      @map("diary_id")
  imageUrl  String   @map("image_url") @db.VarChar(255) // 이미지 자체가 아니라 '주소'
  sortOrder Int      @default(1) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
  @@map("photos")
}

// ============================================
// Musics — 그날의 음악
// ============================================

model Music {
  id         Int      @id @default(autoincrement())
  diaryId    Int      @map("diary_id")
  title      String   @db.VarChar(150)
  artist     String?  @db.VarChar(100)
  youtubeUrl String?  @map("youtube_url") @db.VarChar(255)
  spotifyUrl String?  @map("spotify_url") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
  @@map("musics")
}

// =======================================================
// Tags — 태그 사전
// 같은 이름의 태그는 딱 하나만 존재하고, 여러 일기가 그걸 공유한다.
// =======================================================

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(30)

  diaryTags DiaryTag[]

  @@map("tags")
}

// ===========================================================
// DiaryTags — 일기 ↔ 태그 연결 테이블 (N:M)
// 이 테이블은 '결혼 증명서' 같은 것.
// 일기 정보도 태그 정보도 없고, 오직 "누구와 누구가 엮였다"만 기록한다.
// ===========================================================

model DiaryTag {
  diaryId Int @map("diary_id")
  tagId   Int @map("tag_id")

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // 복합 PK — 두 컬럼을 묶어서 하나의 열쇠로 쓴다.
  // 덕분에 같은 일기에 같은 태그가 두 번 붙는 걸 DB가 막아준다.
  @@id([diaryId, tagId])
  @@index([diaryId])
  @@index([tagId])
  @@map("diary_tags")
}

// ===============================================================================
// AIReports — AI가 만든 월간/연간 회고
// 모델명을 AIReport가 아니라 AiReport로 쓴 이유:
// Prisma Client 호출이 prisma.aIReport(어색) 대신 prisma.aiReport(자연스러움)가 된다.
// ===============================================================================

model AiReport {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  reportType  ReportType @map("report_type")
  targetYear  Int        @map("target_year")
  targetMonth Int?       @map("target_month") // YEAR 리포트면 비어 있음
  content     String     @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_reports")
}

// ============================================
// TimeCapsules — 미래에 열어보는 일기
// ============================================

model TimeCapsule {
  id       Int      @id @default(autoincrement())
  diaryId  Int      @unique @map("diary_id") // @unique가 1:N 1:1로 바꾸는 스위치
  openAt   DateTime @map("open_at")
  isOpened Boolean  @default(false) @map("is_opened")

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@map("time_capsules")
}
